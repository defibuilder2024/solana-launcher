# The launch API. Get a key with one call (no account):  curl "https://api.trenchy.tools/api/create-api-key?label=solana-launcher"
LAUNCH_API_URL=https://api.trenchy.tools
LAUNCH_API_KEY=

# Where your wallet files live. Leave empty for ./wallets inside this repo (git-ignored). Set the same folder in every starter to share wallets.
WALLET_BACKUP_DIR=

# Jito tip paid inside the create transaction of a launch bundle (lamports; 5000000 = 0.005 SOL)
JITO_TIP_LAMPORTS=5000000

# The suite (optional, read at build time). With a domain the switcher in the header links to https://solana.<domain>,
# https://robinhood.<domain>, …; without one it links to each app's local port (this one: 4101).
NEXT_PUBLIC_SUITE_DOMAIN=
NEXT_PUBLIC_HOME_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_REPO_URL=
